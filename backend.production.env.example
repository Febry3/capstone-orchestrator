# Backend runtime environment for production profile in orchestrator

APP_PORT=8082
APP_MODE=release
APP_ENVIRONMENT=production

LOG_LEVEL=info

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DBNAME=eventin
DATABASE_SSLMODE=disable
DATABASE_TIME_ZONE=Asia/Jakarta
DATABASE_MAX_OPEN_CONNS=100
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_CONN_MAX_IDLE_TIME=30m

JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TTL=168h
JWT_REFRESH_TTL=168h

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_BUCKET=uploads

MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=true

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

ASYNQ_CONCURRENCY=10
ORDER_PAYMENT_EXPIRY=5m

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@example.com
MAIL_FROM_NAME=TemanBicara

OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OAUTH_SECRET_KEY=your-google-secret-key
OAUTH_REDIRECT_URL=http://localhost:13000

RUSTFS_URL=http://rustfs:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
